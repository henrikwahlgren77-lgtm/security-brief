# Copy to .env on the server. Never commit real values.
APP_NAME="Northern Europe Security Brief"

# Site authentication (HTTP Basic). Use a unique, strong password.
APP_ADMIN_USER=brief
APP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# High-entropy token used only by the trusted report publisher.
INGEST_TOKEN=replace-with-a-long-random-token

# Local development default; docker-compose overrides this to /data.
DATABASE_PATH=./data/security_brief.sqlite3

# The analysis job (docker compose run --rm analysis ...) reads its own file, .env.analysis,
# because it holds model API keys that the web app must never see. Copy .env.analysis.example.
# INGEST_TOKEN above must be identical in both files.

# Fictional design preview under /design (sample content only). Leave unset on the public site.
# DESIGN_PREVIEW=1
