# Application
APP_NAME="Northern Europe Security Brief"
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
BASE_URL=http://127.0.0.1:8000

# Authentication: required for private archive and administration
APP_ADMIN_USER=admin
# Generate a strong unique password; do not use this example in production.
APP_ADMIN_PASSWORD=change-me-before-deploying

# Bearer token for trusted report-ingestion clients
INGEST_TOKEN=replace-with-a-long-random-token

# Reports are private unless deliberately enabled.
PUBLIC_REPORTS=false

# SQLite database location
DATABASE_PATH=./data/security_brief.sqlite3
