# Copy to .env on the server. Never commit real values.
APP_NAME="Northern Europe Security Brief"

# Site authentication (HTTP Basic). Use a unique, strong password.
APP_ADMIN_USER=brief
APP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# High-entropy token used only by the trusted report publisher.
INGEST_TOKEN=replace-with-a-long-random-token

# Local development default; docker-compose overrides this to /data.
DATABASE_PATH=./data/security_brief.sqlite3

# Model-independent analysis roles (used by the separate analysis job, NOT by the web app).
# provider: mock | openai | anthropic | mistral. The mock provider makes no API calls.
# model: the vendor's model identifier, chosen by the operator; no default is assumed.
# Optional per role: _MAX_OUTPUT_TOKENS (default 4096), _PROMPT_VERSION (default: highest, e.g. v1),
# and _PRICE_INPUT_PER_MTOK / _PRICE_OUTPUT_PER_MTOK (set both, or cost is reported as unknown).
# Run the counter-analysis on a different vendor than the main analysis, or it is not independent.
ANALYSIS_COLLECTION_PROVIDER=mock
ANALYSIS_COLLECTION_MODEL=
ANALYSIS_MAIN_ANALYSIS_PROVIDER=mock
ANALYSIS_MAIN_ANALYSIS_MODEL=
ANALYSIS_COUNTER_ANALYSIS_PROVIDER=mock
ANALYSIS_COUNTER_ANALYSIS_MODEL=
ANALYSIS_FINAL_REPORT_PROVIDER=mock
ANALYSIS_FINAL_REPORT_MODEL=

# API keys: set only the ones you use, and only on the machine that runs the analysis job.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
