# Copy to .env.analysis on the server (chmod 600). Never commit real values.
# Read only by the analysis job, never by the web app.

# Must equal INGEST_TOKEN in .env: the job submits drafts through POST /api/reports.
INGEST_TOKEN=replace-with-the-same-token-as-in-.env

# provider: openai | anthropic | mistral  (mock is refused unless the job is run with --allow-mock)
# model: the vendor's model identifier, chosen by you; no default is assumed.
# Run the counter-analysis on a DIFFERENT vendor than the main analysis, or it is not independent
# (the draft then carries a warning).
ANALYSIS_COLLECTION_PROVIDER=mistral
ANALYSIS_COLLECTION_MODEL=
ANALYSIS_MAIN_ANALYSIS_PROVIDER=openai
ANALYSIS_MAIN_ANALYSIS_MODEL=
ANALYSIS_COUNTER_ANALYSIS_PROVIDER=anthropic
ANALYSIS_COUNTER_ANALYSIS_MODEL=
ANALYSIS_FINAL_REPORT_PROVIDER=openai
ANALYSIS_FINAL_REPORT_MODEL=

# Optional per role (replace ROLE with COLLECTION, MAIN_ANALYSIS, COUNTER_ANALYSIS or FINAL_REPORT):
# ANALYSIS_ROLE_MAX_OUTPUT_TOKENS=4096
# ANALYSIS_ROLE_PROMPT_VERSION=v2
# Set BOTH prices (per million tokens) to get cost estimates; otherwise cost is reported as unknown.
# ANALYSIS_ROLE_PRICE_INPUT_PER_MTOK=
# ANALYSIS_ROLE_PRICE_OUTPUT_PER_MTOK=

# API keys: set only the vendors you use.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
